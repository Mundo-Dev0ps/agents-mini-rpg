{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "moduleResolution": "node"
  },
  "include": [
    "index.ts",
    "mcp-server.ts",
    "show-config.ts",
    "scripts/**/*.ts",
    "core/**/*.ts",
    "cli/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
